// Warmthplace Art Studio — data model
// Development uses SQLite. For production, switch `provider` to "postgresql"
// and point DATABASE_URL at a managed Postgres instance (see README).
// String fields are used instead of enums so the schema stays portable;
// allowed values are enforced in src/lib/constants.ts + zod validation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Artist {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  discipline    String
  location      String?
  shortBio      String
  bio           String
  portraitImage String?
  coverImage    String?
  isSample      Boolean   @default(false)
  published     Boolean   @default(true)
  position      Int       @default(0)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  department    String // ART | DECOR
  category      String // see constants.ts
  productType   String // ORIGINAL | EDITION | PRINT | DECOR | MADE_TO_ORDER
  editionSize   Int?
  description   String
  medium        String?
  materials     String?
  year          Int?
  widthCm       Float?
  heightCm      Float?
  depthCm       Float?
  weightKg      Float?
  orientation   String? // PORTRAIT | LANDSCAPE | SQUARE
  price         Int // minor units (kobo for NGN)
  currency      String         @default("NGN")
  stock         Int            @default(0)
  status        String         @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  enquiryOnly   Boolean        @default(false)
  shippingClass String         @default("STANDARD") // STANDARD | FRAGILE | OVERSIZED
  featured      Boolean        @default(false)
  isSample      Boolean        @default(false)
  artistId      String?
  artist        Artist?        @relation(fields: [artistId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  collections   Collection[]
  orderItems    OrderItem[]
  enquiries     Enquiry[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([department, status])
  @@index([artistId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)

  @@index([productId])
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  subtitle    String?
  description String
  coverImage  String?
  coverAlt    String?
  published   Boolean   @default(true)
  featured    Boolean   @default(false)
  position    Int       @default(0)
  isSample    Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  category    String
  coverImage  String?
  coverAlt    String?
  authorName  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  isSample    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id               String       @id @default(cuid())
  reference        String       @unique
  idempotencyKey   String       @unique
  email            String
  firstName        String
  lastName         String
  phone            String
  address1         String
  address2         String?
  city             String
  region           String?
  postalCode       String?
  country          String
  shippingZoneName String?
  subtotal         Int
  shippingTotal    Int
  taxTotal         Int
  total            Int
  currency         String
  status           String       @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | FAILED | CANCELLED | REFUNDED | NEEDS_REVIEW
  fulfilmentStatus String       @default("UNFULFILLED") // UNFULFILLED | PROCESSING | SHIPPED | DELIVERED
  paymentProvider  String
  paymentUrl       String?
  providerRef      String?
  paidAt           DateTime?
  trackingNumber   String?
  trackingUrl      String?
  customerNote     String?
  internalNote     String?
  marketingConsent Boolean      @default(false)
  items            OrderItem[]
  events           OrderEvent[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([email])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title      String
  artistName String?
  imageUrl   String?
  unitPrice  Int
  quantity   Int

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Records every processed payment notification so that replays are ignored.
model PaymentEvent {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  provider  String
  reference String
  payload   String
  createdAt DateTime @default(now())
}

model ShippingZone {
  id                 String   @id @default(cuid())
  name               String
  countries          String // comma-separated ISO 3166-1 alpha-2 codes
  baseRate           Int
  additionalItemRate Int      @default(0)
  fragileSurcharge   Int      @default(0)
  oversizedSurcharge Int      @default(0)
  allowOversized     Boolean  @default(true)
  freeOver           Int?
  estimate           String
  active             Boolean  @default(true)
  position           Int      @default(0)
  isSample           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Enquiry {
  id        String   @id @default(cuid())
  type      String // GENERAL | PRODUCT | COMMISSION | TRADE
  name      String
  email     String
  phone     String?
  message   String
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  status    String   @default("NEW") // NEW | IN_PROGRESS | CLOSED
  createdAt DateTime @default(now())
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  consentText    String
  consentAt      DateTime
  source         String
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("STAFF") // OWNER | STAFF
  createdAt    DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
