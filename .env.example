# ─── Database ────────────────────────────────────────────────────────────
# Local SQLite fallback:
DATABASE_URL="file:./dev.db"

# Or Supabase (PostgreSQL) — copy from Supabase Dashboard -> Project Settings -> Database:
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Supabase Client Keys (optional for browser / storage operations) ────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public canonical origin (no trailing slash). Used for canonical URLs, sitemap, payment callbacks.
SITE_URL="http://localhost:3000"
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-string"

# ─── Sample / preview mode ───────────────────────────────────────────────
# Shows the "preview store" banner and sample badges. Set to "false" once real inventory is loaded.
NEXT_PUBLIC_SAMPLE_MODE="true"

# ─── Initial admin (used only by `npm run db:seed`) ───────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# ─── Store ───────────────────────────────────────────────────────────────
# Base operating currency: all prices are stored and charged in this currency.
STORE_CURRENCY="NGN"

# ─── Payments ────────────────────────────────────────────────────────────
# "paystack" for real payments, "mock" for local testing (mock is refused when NODE_ENV=production).
PAYMENT_PROVIDER="mock"
PAYSTACK_SECRET_KEY=""

# ─── Email (Resend). If unset, emails are logged to the server console. ──
RESEND_API_KEY=""
EMAIL_FROM="Warmthplace Art Studio <orders@your-domain.com>"
STORE_NOTIFICATION_EMAIL=""

# ─── Public business details (leave blank until confirmed) ───────────────
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_STUDIO_ADDRESS=""
NEXT_PUBLIC_INSTAGRAM=""

# ─── Analytics (optional; loaded only after visitor consent) ──────────────
NEXT_PUBLIC_GA_ID=""
